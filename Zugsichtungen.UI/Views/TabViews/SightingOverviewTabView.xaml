<customControls:TabView x:Class="Zugsichtungen.UI.Views.TabViews.SightingOverviewTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Zugsichtungen.UI.Views.TabViews"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:customControls="clr-namespace:Zugsichtungen.UI.Controls.CustomControls;assembly=Zugsichtungen.UI.Controls"
                xmlns:converter="clr-namespace:Zugsichtungen.UI.Converter"
                xmlns:vm="clr-namespace:Zugsichtungen.ViewModels;assembly=Zugsichtungen.ViewModels"
                xmlns:dialogViewModel="clr-namespace:Zugsichtungen.ViewModels.DialogViewModels;assembly=Zugsichtungen.ViewModels"
                        xmlns:itemviews="clr-namespace:Zugsichtungen.UI.Views.ItemViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <customControls:TabView.Resources>
        <converter:DateOnlyToGermanDateConverter x:Key="DateOnlyToGermanDateConverter" />

        <DataTemplate x:Key="CheckedListBoxItemTemplate">
            <itemviews:CheckedListBoxItemView />
        </DataTemplate>
    </customControls:TabView.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Baureihen"
                        Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}"
                        Margin="5"/>
            <ListBox Grid.Row="1"
                     ItemTemplate="{StaticResource CheckedListBoxItemTemplate}"
                     ItemsSource="{Binding SeriesView, Mode=OneTime}"/>

            <TextBlock Text="Fahrzeugfilter"
                        Grid.Row="2"
                       Margin="5"
                        Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}"/>
            <ListBox Grid.Row="3"
                     ItemTemplate="{StaticResource CheckedListBoxItemTemplate}"
                     ItemsSource="{Binding VehicleView, Mode=OneTime}"/>
        </Grid>

        <Rectangle Grid.Column="1" 
                   VerticalAlignment="Stretch"
                   Width="1"
                   Fill="LightGray"
                   Margin="0,5"/>

        <DataGrid AutoGenerateColumns="False"
                  ItemsSource="{Binding SightingsView, Mode=OneTime}"
                      SelectedItem="{Binding SelectedItem}" 
                      Grid.Row="0"
                  Grid.Column="2"
                      Margin="10">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                      Command="{Binding ShowSightingDetailsCommand, Mode=OneTime}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Datum" Binding="{Binding Date,Converter={StaticResource DateOnlyToGermanDateConverter}, Mode=OneWay}" IsReadOnly="True" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Fahrzeug" Binding="{Binding Number, Mode=OneWay}" IsReadOnly="True" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Ort" Binding="{Binding Location, Mode=OneWay}" IsReadOnly="True" />
                <DataGridTextColumn Header="Thema" Binding="{Binding Context, Mode=OneWay}" IsReadOnly="True" />
                <DataGridTextColumn Header="Bemerkung" Binding="{Binding Note, Mode=OneWay}" IsReadOnly="True" />
            </DataGrid.Columns>

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="5" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="False">
                                            <Expander.Header>
                                                <DockPanel>
                                                    <TextBlock FontWeight="Bold"
                                                               Text="{Binding Path=Name}"
                                                               Margin="5,0,5,0"/>
                                                    <TextBlock Text="Sichtungen: " />
                                                    <TextBlock Text="{Binding Path=ItemCount}"
                                                               Margin="0,0,0,0"/>
                                                </DockPanel>
                                            </Expander.Header>
                                            <Expander.Content>
                                                <ItemsPresenter />
                                            </Expander.Content>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, Converter={StaticResource DateOnlyToGermanDateConverter}}"
                                       FontWeight="Bold"
                                       Background="LightGray"
                                       Padding="5" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>            
        </DataGrid>

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource MaterialDesignFloatingActionButton}"
                Foreground="White"
                Content="{materialDesign:PackIcon Kind=Add,Size=30}"
                Margin="30"
                Command="{Binding AddSichtungCommand, Mode=OneTime}"
                Grid.Column="2"/>
    </Grid>
</customControls:TabView>
